<Window x:Class="ProcBridge.Launcher.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProcBridge.Launcher.Wpf.ViewModels"
        xmlns:views="clr-namespace:ProcBridge.Launcher.Wpf.Views"
        xmlns:enums="clr-namespace:ProcBridge.Agent.Explorer.Enums;assembly=ProcBridge.Agent.Explorer"
        Title="ProcBridge Launcher" Width="1100" Height="760" MinWidth="760" MinHeight="480"
        Closing="OnClosing">
    <TabControl Margin="6">
        <!-- Machines B: paired list and pairing a new one. -->
        <TabItem Header="Máy B">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap">
                        <Run Text="Vân tay máy này:" />
                        <Run Text="{Binding Machines.OwnFingerprint, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" />
                    </TextBlock>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Làm mới" Command="{Binding Machines.RefreshCommand}" />
                        <Button Content="Thu hồi…" Command="{Binding Machines.RevokeCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Machines.Machines}" SelectedItem="{Binding Machines.SelectedMachine}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="Auto" />
                            <DataGridTextColumn Header="Vân tay" Binding="{Binding Fingerprint}" Width="Auto" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Ghép cặp lúc (UTC)" Binding="{Binding PairedAtUtc, StringFormat=u}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <GroupBox Grid.Column="2" Header="Ghép cặp máy B mới" DataContext="{Binding Machines.Pairing}" VerticalAlignment="Top">
                    <StackPanel Margin="8">
                        <TextBlock Text="Địa chỉ máy B (host hoặc host:port):" />
                        <DockPanel Margin="0,2,0,8">
                            <Button DockPanel.Dock="Right" Content="Kết nối" Command="{Binding StartCommand}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Vân tay máy này (đọc cho máy B so):" />
                            <LineBreak />
                            <Run Text="{Binding OwnFingerprint, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0">
                            <Run Text="Vân tay máy B (so với vân tay máy B hiển thị):" />
                            <LineBreak />
                            <Run Text="{Binding AgentFingerprint, Mode=OneWay, TargetNullValue='—'}" FontFamily="Consolas" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="Mã 6 số máy B hiển thị:" Margin="0,8,0,0" />
                        <DockPanel Margin="0,2,0,8">
                            <Button DockPanel.Dock="Right" Content="Huỷ" Command="{Binding CancelCommand}" Margin="6,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="Xác nhận" Command="{Binding ConfirmCodeCommand}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" FontFamily="Consolas"
                                     IsEnabled="{Binding IsWaitingForCode}" />
                        </DockPanel>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>
            </Grid>
        </TabItem>

        <!-- Run profiles: editor, Run/Stop, log. -->
        <TabItem Header="Hồ sơ chạy" DataContext="{Binding Profiles}">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Thêm" Command="{Binding AddCommand}" MinWidth="0" />
                            <Button Content="Xoá…" Command="{Binding RemoveCommand}" MinWidth="0" />
                            <Button Content="Lưu" Command="{Binding SaveCommand}" MinWidth="0" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
                </DockPanel>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420" DataContext="{Binding SelectedProfile}"
                                  IsEnabled="{Binding DataContext.Run.IsRunning, RelativeSource={RelativeSource AncestorType=TabItem}, Converter={x:Static views:InverseBooleanConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0,3" />
                                </Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Margin" Value="0,3" />
                                </Style>
                            </Grid.Resources>
                            <TextBlock Text="Tên hồ sơ" />
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Text="Máy B" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                      ItemsSource="{Binding DataContext.Machines.Machines, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                      SelectedValuePath="Fingerprint" SelectedValue="{Binding MachineFingerprint}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="{Binding Address, Mode=OneWay, StringFormat=' ({0})'}" Foreground="Gray" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="Tên chia sẻ (share)" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ShareName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" Text="Gốc chia sẻ trên B" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ShareRoot, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="3" Grid.Column="2" Content="Duyệt máy B…" Command="{Binding PickShareRootCommand}" Margin="6,3,0,3" />

                            <TextBlock Grid.Row="4" Text="Ánh xạ thư mục" VerticalAlignment="Top" Margin="0,6" />
                            <DataGrid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}"
                                      IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="90" Margin="0,3">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Thư mục ảo trên máy này" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="…" MinWidth="0" Margin="2,0,0,0" Padding="6,0"
                                                            Command="{Binding DataContext.PickVirtualRootCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                    <TextBox Text="{Binding VirtualRoot, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Thư mục trên máy B" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Duyệt máy B…" MinWidth="0" Margin="2,0,0,0" Padding="6,0"
                                                            Command="{Binding DataContext.PickRemotePathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                    <TextBox Text="{Binding RemotePath, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Bỏ" MinWidth="0" Padding="6,0" Margin="0"
                                                        Command="{Binding DataContext.RemoveMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Content="Thêm ánh xạ" Command="{Binding AddMappingCommand}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="6" Text="Chương trình" />
                            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Program, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="7" Text="Tham số" />
                            <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="8" Text="Thư mục làm việc" />
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="8" Grid.Column="2" Content="…" Command="{Binding PickWorkingDirectoryCommand}" Margin="6,3,0,3" />

                            <StackPanel Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2">
                            <WrapPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Kiến trúc" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{x:Static vm:ProfileViewModel.Architectures}" SelectedItem="{Binding Architecture}" Width="70" />
                                <CheckBox Content="Tắt build server (MSBuild/Roslyn) trong lần chạy" IsChecked="{Binding DisableBuildServers}"
                                          VerticalAlignment="Center" Margin="16,0,0,0" />
                                <CheckBox Content="Ghi xuyên (gửi từng lần ghi sang máy B ngay)" IsChecked="{Binding WriteThrough}"
                                          VerticalAlignment="Center" Margin="16,0,0,0" />
                                <CheckBox Content="Xung đột: máy này ghi đè (mặc định giữ cả hai bản)" IsChecked="{Binding OverwriteOnConflict}"
                                          VerticalAlignment="Center" Margin="16,0,0,0" />
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,4">
                                <CheckBox Content="Kết nối qua relay (internet)" IsChecked="{Binding UseRelay}" VerticalAlignment="Center"
                                          ToolTip="Đi qua relay thay vì địa chỉ LAN của máy B; dữ liệu vẫn mã hoá đầu cuối." />
                                <TextBlock Text="Relay" Margin="16,0,6,0" VerticalAlignment="Center" />
                                <TextBox Text="{Binding RelayUrl, UpdateSourceTrigger=PropertyChanged}" Width="220" IsEnabled="{Binding UseRelay}"
                                         ToolTip="Địa chỉ relay, vd https://relay.example.com/. Không cần tài khoản: máy B được tìm theo vân tay khoá đã ghép cặp." />
                            </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                        <Button Content="Chạy" Command="{Binding RunCommand}" FontWeight="SemiBold" />
                        <Button Content="Dừng (kill cả cây)" Command="{Binding Run.StopCommand}" />
                        <Button Content="Xoá log" Command="{Binding Run.ClearLogCommand}" />
                        <TextBlock Text="{Binding Run.StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Run.Log}" FontFamily="Consolas" x:Name="LogList"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </TabItem>

        <!-- Remote Explorer: read only pages, writes only with the matching permission. -->
        <TabItem Header="Remote Explorer" DataContext="{Binding Explorer}">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Máy B:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Machines.Machines}" SelectedItem="{Binding SelectedMachine}" DisplayMemberPath="Name" Width="240" Margin="0,0,6,0" />
                    <Button Content="Kết nối" Command="{Binding ConnectCommand}" />
                    <Button Content="Ngắt" Command="{Binding DisconnectCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TabControl IsEnabled="{Binding IsConnected}">
                    <TabItem Header="File" DataContext="{Binding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Làm mới" Command="{Binding Files.RefreshCommand}" Margin="0,4" />
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Text="{Binding Files.ErrorText}"
                                           Visibility="{Binding Files.HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                <TreeView ItemsSource="{Binding Files.Roots}">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:RemoteFolderNodeViewModel}" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding ErrorText, StringFormat=' — {0}'}" Foreground="Firebrick"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Files.SelectedPath}" Margin="0,8,0,4" FontWeight="SemiBold" />
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Text="{Binding Files.SelectedNode.ErrorText}"
                                           Visibility="{Binding Files.SelectedNode.HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                <DataGrid x:Name="FileGrid" ItemsSource="{Binding Files.SelectedNode.Files}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Cỡ (byte)" Binding="{Binding Size, StringFormat=N0}" Width="Auto" />
                                        <DataGridTextColumn Header="Sửa lúc (UTC)" Binding="{Binding LastWriteTimeUtc, StringFormat=u}" Width="Auto" />
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Xoá…" MinWidth="0" Padding="6,0" Margin="0"
                                                            Visibility="{Binding DataContext.CanWriteFiles, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Process">
                        <DockPanel DataContext="{Binding Processes}">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4">
                                <Button Content="Làm mới" Command="{Binding RefreshCommand}" />
                                <Button Content="Kill cây…" Command="{Binding KillCommand}" Visibility="{Binding CanKill, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Text="{Binding ErrorText}"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            <DataGrid ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="200" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" />
                                    <DataGridTextColumn Header="PID cha" Binding="{Binding ParentPid}" />
                                    <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" />
                                    <DataGridTextColumn Header="RAM (byte)" Binding="{Binding WorkingSetBytes, StringFormat=N0}" />
                                    <DataGridTextColumn Header="Bắt đầu (UTC)" Binding="{Binding StartTimeUtc, StringFormat=u}" />
                                    <DataGridTextColumn Header="Đường dẫn" Binding="{Binding ImagePath}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Registry">
                        <DockPanel DataContext="{Binding Registry}">
                            <DockPanel DockPanel.Dock="Top" Margin="0,4">
                                <Button DockPanel.Dock="Right" Content="Lên" Command="{Binding UpCommand}" Margin="6,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Mở" Command="{Binding RefreshCommand}" Margin="6,0,0,0" />
                                <ComboBox ItemsSource="{Binding Roots}" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Text="{Binding ErrorText}"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding CanWrite, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <Button Content="Xoá giá trị…" Command="{Binding DeleteValueCommand}" />
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="SubKeyList" ItemsSource="{Binding SubKeys}" MouseDoubleClick="OnSubKeyDoubleClick" ToolTip="Nhấp đúp để mở khoá con" />
                                <DataGrid Grid.Column="2" ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedValue}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="200" />
                                        <DataGridTextColumn Header="Kiểu" Binding="{Binding Type}" />
                                        <DataGridTextColumn Header="Dữ liệu" Binding="{Binding Converter={StaticResource RegistryValueData}}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Service">
                        <DockPanel DataContext="{Binding Services}">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4">
                                <Button Content="Làm mới" Command="{Binding RefreshCommand}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding CanControl, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                    <Button Content="Start…" Command="{Binding ControlCommand}" CommandParameter="{x:Static enums:ServiceControlAction.Start}" />
                                    <Button Content="Stop…" Command="{Binding ControlCommand}" CommandParameter="{x:Static enums:ServiceControlAction.Stop}" />
                                    <Button Content="Restart…" Command="{Binding ControlCommand}" CommandParameter="{x:Static enums:ServiceControlAction.Restart}" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Text="{Binding ErrorText}"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            <DataGrid ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên hiển thị" Binding="{Binding DisplayName}" Width="*" />
                                    <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="200" />
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" />
                                    <DataGridTextColumn Header="Khởi động" Binding="{Binding StartType}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Hệ thống">
                        <DockPanel DataContext="{Binding SystemInfo}">
                            <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Làm mới" Command="{Binding RefreshCommand}" Margin="0,4" />
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Text="{Binding ErrorText}"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            <ItemsControl ItemsSource="{Binding Summary}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Foreground="Gray" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
