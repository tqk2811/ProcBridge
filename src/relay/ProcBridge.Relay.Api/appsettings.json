{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Relay": {
    "RateLimit": {
      "TunnelSessionPermitLimit": 60,
      "ControlPermitLimit": 20,
      "LanePermitLimit": 600,
      "PairingPermitLimit": 10,
      "Window": "00:01:00"
    },
    "Tunnel": {
      "SessionLifetime": "00:01:00",
      "PairTimeout": "00:00:30",
      "CloseGrace": "00:00:10",
      "BufferSize": 65536,
      "ControlHandshakeTimeout": "00:00:10",
      "MaxControlChannelsPerAddress": 16,
      "MaxSessionsPerHost": 64,
      "MaxSessionsPerAddress": 64,
      "MaxLanesPerAddress": 256,
      "PairingSlotLifetime": "00:05:00"
    }
  }
}
