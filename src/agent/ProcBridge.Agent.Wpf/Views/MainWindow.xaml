<Window x:Class="ProcBridge.Agent.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProcBridge.Agent.Wpf.Core.ViewModels;assembly=ProcBridge.Agent.Wpf.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ProcBridge Agent" Width="900" Height="600" MinWidth="640" MinHeight="420">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" />
        </StackPanel>
        <TabControl>
            <TabItem Header="Máy chủ">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Vân tay máy này:" Margin="0,0,8,4" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Fingerprint, Mode=OneWay}" Style="{StaticResource Mono}" FontSize="14" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Text="Quyền:" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElevationText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="2" Text="Địa chỉ nghe:" Margin="0,0,8,4" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                                <TextBox Text="{Binding BindAddress, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                <TextBlock Text="Cổng:" Margin="12,0,6,0" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="Relay (internet):" Margin="0,0,8,4" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                                    <TextBox Text="{Binding RelayUrl, UpdateSourceTrigger=PropertyChanged}" Width="260"
                                             ToolTip="Địa chỉ relay, vd https://relay.example.com/. Để trống thì chỉ phục vụ trong LAN." />
                                    <TextBlock Text="Token máy:" Margin="12,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding RelayToken, UpdateSourceTrigger=PropertyChanged}" Width="220" Style="{StaticResource Mono}"
                                             ToolTip="Token máy (pbd_...) từ procbridge-relay device register; lưu mã hoá DPAPI." />
                                </StackPanel>
                                <TextBlock Text="{Binding RelayState}" Margin="0,2,0,0" Foreground="Gray" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,8">
                                <Button Content="Khởi động" Command="{Binding StartCommand}" />
                                <Button Content="Dừng" Command="{Binding StopCommand}" />
                                <CheckBox Content="Cho phép ghép cặp máy mới" IsChecked="{Binding AllowPairing}" VerticalAlignment="Center" Margin="12,0,0,0"
                                          ToolTip="Bật khi máy A cần ghép cặp; tự tắt sau khi ghép cặp thành công." />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Máy đang kết nối" FontWeight="SemiBold" Margin="0,4,0,4" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Connections}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name, Mode=OneWay}" Width="160" />
                            <DataGridTextColumn Header="Vân tay" Binding="{Binding Fingerprint, Mode=OneWay}" Width="330" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Địa chỉ" Binding="{Binding RemoteAddresses, Mode=OneWay}" Width="140" />
                            <DataGridTextColumn Header="Số kết nối" Binding="{Binding ConnectionCount, Mode=OneWay}" Width="80" />
                            <DataGridTextColumn Header="Từ lúc" Binding="{Binding ConnectedSinceLocal, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Thư mục chia sẻ">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Thêm..." Command="{Binding AddShareCommand}" />
                        <Button Content="Xoá" Command="{Binding RemoveShareCommand}" />
                        <Button Content="Lưu" Command="{Binding SaveCommand}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="DarkOrange" Text="Đã sửa thư mục chia sẻ khi máy chủ đang chạy: dừng rồi khởi động lại để áp dụng."
                                   Visibility="{Binding SharesNeedRestart, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray"
                                   Text="Cột 'Cho ghi' chỉ được lưu lại: Agent hiện vẫn phục vụ mọi thư mục ở chế độ chỉ đọc cho tới khi phía máy chủ có đường ghi (M3)." />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Shares}" SelectedItem="{Binding SelectedShare}" AutoGenerateColumns="False" HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="160" />
                            <DataGridTextColumn Header="Thư mục" Binding="{Binding Path, UpdateSourceTrigger=LostFocus}" Width="*" />
                            <DataGridCheckBoxColumn Header="Cho ghi" Binding="{Binding AllowWrite, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Máy đã ghép cặp">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Quyền Explorer..." Command="{Binding EditExplorerPolicyCommand}" MinWidth="120" />
                        <Button Content="Thu hồi" Command="{Binding RevokeCommand}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="Gray" Margin="0,6,0,0"
                               Text="Máy mới ghép cặp chưa có quyền Explorer nào. Đổi quyền áp dụng cho các kết nối mới của máy đó." />
                    <DataGrid ItemsSource="{Binding PairedMachines}" SelectedItem="{Binding SelectedPairedMachine}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên" Binding="{Binding Name, Mode=OneWay}" Width="160" />
                            <DataGridTextColumn Header="Vân tay" Binding="{Binding Fingerprint, Mode=OneWay}" Width="330" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Ghép cặp lúc" Binding="{Binding PairedAtLocal, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}" Width="120" />
                            <DataGridTextColumn Header="Lần cuối" Binding="{Binding LastSeenText, Mode=OneWay}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Cài đặt">
                <StackPanel Margin="8">
                    <CheckBox Content="Khởi động máy chủ ngay khi mở ứng dụng" IsChecked="{Binding StartServerOnLaunch}" Margin="0,0,0,6" />
                    <CheckBox Content="Đóng cửa sổ thì thu xuống khay hệ thống (máy chủ vẫn chạy)" IsChecked="{Binding MinimizeToTray}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
